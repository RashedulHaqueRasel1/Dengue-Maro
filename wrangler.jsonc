{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project: static game in ./public, /api/* forwarded to the
  // dengue-maro-api Worker (./api) through the API service binding.
  "name": "dengue-maro",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-09-01",
  "services": [{ "binding": "API", "service": "dengue-maro-api" }]
}
